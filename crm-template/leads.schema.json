{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlabjournal.online/crm-template/leads.schema.json",
  "title": "AgentLab CRM lead record",
  "type": "object",
  "required": ["lead_id", "submitted_at", "name", "contact", "status", "status_changed_at", "pilot_result"],
  "properties": {
    "lead_id": {"type": "string"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "name": {"type": "string"},
    "contact": {"type": "string"},
    "channel": {"type": "string"},
    "process": {"type": "string"},
    "article_slug": {"type": "string"},
    "cta_topic": {"enum": ["telegram", "email", "crm", "reports", "general"]},
    "utm_source": {"type": ["string", "null"]},
    "utm_medium": {"type": ["string", "null"]},
    "utm_campaign": {"type": ["string", "null"]},
    "status": {"enum": ["new", "contacted", "qualified", "offer_sent", "paid", "lost"]},
    "status_changed_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"},
    "offer_price": {"type": ["number", "null"]},
    "payment_received": {"type": "boolean"},
    "pilot_result": {"enum": ["pending", "success", "failed", "cancelled"]},
    "lost_reason": {"type": "string"}
  }
}
