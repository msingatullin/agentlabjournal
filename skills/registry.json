{
  "version": "1.0",
  "pipeline": [
    {"id": "publication-gate", "command": "scripts/check-publication.py", "required": true},
    {"id": "source-fact-check", "mode": "deterministic", "required": true},
    {"id": "article-to-distribution", "command": "scripts/build-content-pack.py", "required": true},
    {"id": "weekly-funnel-review", "command": "scripts/weekly-funnel-report.py", "required": false},
    {"id": "strategic-advisor", "mode": "deterministic", "required": true}
  ],
  "external_publish": "manual_approval_only",
  "seo_gate": "fail_closed"
}
