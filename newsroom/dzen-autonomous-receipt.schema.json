{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "published", "slug", "canonical_url", "reason", "gates", "notebooklm_score", "image_sha256", "commit", "recrawl_task_id"],
  "properties": {
    "status": {"enum": ["PUBLISHED", "PREPARED", "BLOCKED", "SKIPPED"]},
    "published": {"type": "boolean"},
    "slug": {"type": ["string", "null"]},
    "canonical_url": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "gates": {"type": "object"},
    "notebooklm_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "image_sha256": {"type": ["string", "null"]},
    "commit": {"type": ["string", "null"]},
    "recrawl_task_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
