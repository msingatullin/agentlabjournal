{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "published", "slug", "gates"],
  "properties": {
    "status": {"enum": ["PUBLISHED", "PREPARED", "BLOCKED", "SKIPPED"]},
    "published": {"type": "boolean"},
    "slug": {"type": "string"},
    "canonical_url": {"type": "string"},
    "reason": {"type": "string"},
    "gates": {"type": "object"},
    "notebooklm_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "image_sha256": {"type": "string"},
    "commit": {"type": "string"},
    "recrawl_task_id": {"type": "string"}
  },
  "additionalProperties": true
}
