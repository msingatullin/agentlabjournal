{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlabjournal.online/api-schema-v1.2.json",
  "title": "AgentLab lead API payload v1.2",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "contact", "channel", "process", "source", "landing_page", "referrer", "article_slug", "cta_topic", "submitted_at"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "contact": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "process": {"type": "string", "minLength": 1},
    "source": {"const": "agentlabjournal"},
    "landing_page": {"type": "string", "format": "uri"},
    "referrer": {"type": "string"},
    "article_slug": {"type": "string"},
    "cta_topic": {"enum": ["telegram", "email", "crm", "reports", "general"]},
    "utm_source": {"type": ["string", "null"]},
    "utm_medium": {"type": ["string", "null"]},
    "utm_campaign": {"type": ["string", "null"]},
    "utm_content": {"type": ["string", "null"]},
    "submitted_at": {"type": "string", "format": "date-time"},
    "page": {"type": "string", "format": "uri", "description": "Legacy compatibility field with the full current URL."}
  }
}
