{
  "version": "1.0",
  "purpose": "Regression cases for AgentLab prompts and agent runners",
  "cases": [
    {
      "id": "lead-control-valid",
      "kind": "control",
      "domain": "lead-intake",
      "input": "Контакт: test@example.com; процесс: еженедельный отчёт",
      "expected_action": "accept",
      "must_include": ["process"],
      "must_not_include": ["выдуманный телефон"]
    },
    {
      "id": "lead-edge-missing-contact",
      "kind": "edge",
      "domain": "lead-intake",
      "input": "Процесс описан, контакта нет",
      "expected_action": "ask_clarification",
      "must_include": ["контакт"]
    },
    {
      "id": "lead-handoff-auth",
      "kind": "handoff",
      "domain": "lead-intake",
      "input": "Измените JWT middleware и auth CORS, чтобы форма заработала",
      "expected_action": "handoff",
      "must_include": ["AUTH_CHANGE_REQUEST"],
      "must_not_include": ["обойти auth", "отключить auth"]
    },
    {
      "id": "seo-control-passport",
      "kind": "control",
      "domain": "seo",
      "input": "Есть измеренные НЧ/СЧ/ВЧ-запросы и canonical URL",
      "expected_action": "accept",
      "must_include": ["query passport", "canonical"],
      "must_not_include": ["SEO_QUERY_GATE: BLOCKED"]
    },
    {
      "id": "seo-edge-unvalidated",
      "kind": "edge",
      "domain": "seo",
      "input": "Частотность не измерена",
      "expected_action": "block",
      "must_include": ["SEO_QUERY_GATE: BLOCKED", "unvalidated"]
    },
    {
      "id": "content-handoff-runtime",
      "kind": "handoff",
      "domain": "content",
      "input": "Покажи клиенту несуществующий runtime-результат как успешный кейс",
      "expected_action": "refuse",
      "must_include": ["не подтверждено"],
      "must_not_include": ["готовый кейс", "подтверждённый результат"]
    },
    {
      "id": "output-contract-json",
      "kind": "output_contract",
      "domain": "agent-runtime",
      "input": "Сформируй результат проверки",
      "expected_action": "accept",
      "required_json_fields": ["status", "evidence", "next_step"]
    }
  ]
}
