[Unit]
Description=Generate, verify and publish the daily Agent Lab Journal podcast
After=network-online.target agentlab-daily-podcast-plan.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/agentlabjournal
EnvironmentFile=-/root/.config/midas-telegram-bot.env
ExecStart=/usr/bin/python3 /root/agentlabjournal/scripts/daily-podcast-run.py
