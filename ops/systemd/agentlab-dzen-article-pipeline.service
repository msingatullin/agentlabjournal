[Unit]
Description=Autonomous Agent Lab Dzen RSS newsroom cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/agentlabjournal
EnvironmentFile=-/root/.config/midas-telegram-bot.env
ExecStart=/usr/bin/flock -n /run/agentlab-dzen-article.lock /usr/bin/python3 /root/agentlabjournal/scripts/run-dzen-autonomous-isolated.py
TimeoutStartSec=3600
