[Unit]
Description=Prepare and review one Agent Lab Dzen RSS article
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/agentlabjournal
EnvironmentFile=-/root/.config/midas-telegram-bot.env
ExecStart=/usr/bin/python3 /root/agentlabjournal/scripts/dzen-article-pipeline.py prepare --root /root/agentlabjournal --no-publish
TimeoutStartSec=900

